ENVIRONMENT=development
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
CRON_SECRET=
AI_PROVIDER_API_KEY=

# Optional: Meta app secret used for webhook signatures, if different from Instagram Login.
META_WEBHOOK_APP_SECRET=

# Optional Groq business assistant. Live replies start paused.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Shared first-use pilot code; never place in frontend environment variables.
PILOT_ACCESS_CODE=

# WhatsApp shares this backend; messaging payments go directly to Meta.
# Enable after applying migrations 007 + 008 and configuring Meta onboarding/webhooks.
WHATSAPP_ENABLED=false
# Omit these two to reuse the existing Meta app credentials.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_SIGNUP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
